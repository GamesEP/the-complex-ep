-- Post-processing tonemapping default and reference preset catalogue.
--
-- `agx-punchy` is the active default look for The Complex; the remaining presets stay here as
-- documented references (Khronos PBR Neutral from `KhronosGroup/ToneMapping`, AgX Default, ACES
-- Filmic, Uncharted 2, Extended Reinhard, and Roblox's native presets).
--
-- Roblox's `ColorCorrectionEffect.ColorLutContent` accepts `Content` assignments in Studio 0.748
-- without visibly rendering yet (MAD = 0.00 across Object/Opaque/Uri), so `TONEMAPPER_BACKEND_MODE`
-- defaults to `"approx"` (`ColorGradingEffect` + `Lighting.ExposureCompensation` +
-- `ColorCorrectionEffect` + `BloomEffect`). Flip to `"auto"` once Roblox enables the LUT pass.
-- See docs/tonemapping.md.
local Config = {}

export type FallbackCorrection = {
	exposureCompensation: number,
	brightness: number,
	contrast: number,
	saturation: number,
	tintColor: Color3,
	bloomIntensity: number,
	bloomSize: number,
	bloomThreshold: number,
}

export type TonemapperPreset = {
	id: string,
	label: string,
	source: string,
	summary: string,
	-- Native `Enum.TonemapperPreset` name applied underneath ("Default" or "Retro").
	basePreset: "Default" | "Retro",
	-- Pure operator id in `shared/features/tonemapping/Tonemapper`. "none" disables post effects.
	operator: string,
	-- Multiplier applied to exposure before evaluating the 3D LUT operator.
	exposureScale: number,
	-- Pseudo-HDR peak white headroom used when expanding SDR linear values for 3D LUTs.
	hdrWhite: number,
	-- Optional static 1024x32 PNG filename under `assets/` (generated by `scripts/generate-luts.luau`).
	lutFile: string?,
	-- Active in `"approx"` mode and whenever `ColorLutContent` is unavailable.
	fallbackCorrection: FallbackCorrection?,
}

-- Active game default. Switch this single id to change the look to any reference preset below.
Config.TONEMAPPER_DEFAULT = "agx-punchy"

-- Delivery mode: `"approx"` works in current Roblox Studio builds; switch to `"auto"` once Roblox
-- enables the `ColorCorrectionEffect.ColorLutContent` renderer pass.
Config.TONEMAPPER_BACKEND_MODE = "approx"

-- 32^3 cube packed as a 1024x32 horizontal strip (32 tiles of 32x32), matching Roblox's
-- `ColorCorrectionEffect.ColorLutContent` format.
Config.TONEMAPPER_LUT_SIZE = 32
Config.TONEMAPPER_EXPOSURE = 1.0
Config.TONEMAPPER_INTENSITY = 1.0
Config.TONEMAPPER_HDR_WHITE = 4.0

