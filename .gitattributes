# Line endings. Without this a Windows clone checks every file out with CRLF, and then:
# stylua rewrites the whole tree on the first save (stylua.toml pins Unix endings), the
# shell scripts under scripts/ fail in Git Bash with "bad interpreter: /bin/bash^M", and
# every diff between a Windows and a Linux contributor is the entire file.
#
# `text=auto eol=lf` normalises on commit and checks out LF everywhere, which is what the
# toolchain — rojo, lune, stylua, luau-lsp — expects on all three platforms.
* text=auto eol=lf

# Windows-only, and genuinely wants CRLF.
*.ps1 text eol=crlf

# Roblox binaries and media. Never touched, never diffed as text.
*.rbxl  binary
*.rbxm  binary
*.png   binary
*.jpg   binary
*.ogg   binary
*.mp3   binary
*.fbx   binary

# Roblox XML models are text and diff usefully, but they are generated by Studio and by
# `make syncback` — reviewing one line by line is not the point, so they are marked so a
# forge collapses them by default.
*.rbxlx linguist-generated=true
*.rbxmx linguist-generated=true

# Lock files: generated, not hand-edited.
wally.lock linguist-generated=true
