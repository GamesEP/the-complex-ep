# Build outputs. Places are generated from the project, never committed —
# see `make place` / `make build`.
/*.rbxl
/*.rbxlx

# Wally dependencies. wally.toml and wally.lock are the source of truth the same way
# rokit.toml is for the toolchain; the tree itself is downloaded by `make packages`.
/Packages/

# Roblox Studio lock files
/*.rbxlx.lock
/*.rbxl.lock
/*.rbxlx.lock*
/*.rbxl.lock*

# Scratch space for map exports and anything else being fed into a script. Never committed.
/temp/

# Generated by `make sourcemap` from the project file, and rewritten on every module added or
# renamed. Committing it means a merge conflict on every branch that adds a file.
sourcemap.json

# Roblox type definitions for luau-lsp — about 8 MB of generated files that track
# Roblox's releases rather than this repo. Fetch with `make lsp-defs`.
/.lsp/

# Local agent state and machine-local overrides. The committed halves — .claude/settings.json,
# opencode.json, .mcp.json — are shared; these are not.
.tokensave/
.claude/settings.local.json

# Open Cloud credentials for `make logs` — an API key with datastore read scope. Sourced by
# scripts/fetch-logs.sh when present; never committed.
.env
